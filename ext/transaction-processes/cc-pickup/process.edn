;; CC: Campus Connect product pickup process.
;; Seller accepts before capture; mark-ready then privileged complete-pickup (QR scan).
{:format :v3,
 :transitions
 [{:name :transition/inquire,
   :actor :actor.role/customer,
   :actions [{:name :action/update-protected-data}],
   :to :state/inquiry}
  {:name :transition/request-payment,
   :actor :actor.role/customer,
   :privileged? true,
   :actions
   [{:name :action/update-protected-data}
    {:name :action/create-pending-stock-reservation}
    {:name :action/privileged-set-line-items}
    {:name :action/stripe-create-payment-intent}],
   :to :state/pending-payment}
  {:name :transition/request-payment-after-inquiry,
   :actor :actor.role/customer,
   :privileged? true,
   :actions
   [{:name :action/update-protected-data}
    {:name :action/create-pending-stock-reservation}
    {:name :action/privileged-set-line-items}
    {:name :action/stripe-create-payment-intent}],
   :from :state/inquiry,
   :to :state/pending-payment}
  {:name :transition/confirm-payment,
   :actor :actor.role/customer,
   :actions [{:name :action/stripe-confirm-payment-intent}],
   :from :state/pending-payment,
   :to :state/preauthorized}
  {:name :transition/expire-payment,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/pending-payment]}
     {:fn/period ["PT15M"]}]},
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    ;; Keep decline-stock-reservation last
    {:name :action/decline-stock-reservation}],
   :from :state/pending-payment,
   :to :state/payment-expired}
  {:name :transition/accept,
   :actor :actor.role/provider,
   :actions
   [{:name :action/accept-stock-reservation}
    {:name :action/stripe-capture-payment-intent}],
   :from :state/preauthorized,
   :to :state/accepted}
  {:name :transition/decline,
   :actor :actor.role/provider,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-stock-reservation}],
   :from :state/preauthorized,
   :to :state/declined}
  {:name :transition/expire,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/preauthorized]}
     {:fn/period ["P3D"]}]},
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/decline-stock-reservation}],
   :from :state/preauthorized,
   :to :state/declined}
  {:name :transition/mark-ready,
   :actor :actor.role/provider,
   :actions [],
   :from :state/accepted,
   :to :state/ready}
  {:name :transition/complete-pickup,
   :actor :actor.role/provider,
   :privileged? true,
   :actions [{:name :action/stripe-create-payout}],
   :from :state/ready,
   :to :state/completed}
  {:name :transition/auto-complete,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/ready]}
     {:fn/period ["P3D"]}]},
   :actions [{:name :action/stripe-create-payout}],
   :from :state/ready,
   :to :state/completed}
  {:name :transition/provider-cancel-from-accepted,
   :actor :actor.role/provider,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-stock-reservation}],
   :from :state/accepted,
   :to :state/cancelled}
  {:name :transition/provider-cancel-from-ready,
   :actor :actor.role/provider,
   :actions
   [{:name :action/calculate-full-refund}
    {:name :action/stripe-refund-payment}
    {:name :action/cancel-stock-reservation}],
   :from :state/ready,
   :to :state/cancelled}
  {:name :transition/review-1-by-provider,
   :actor :actor.role/provider,
   :actions [{:name :action/post-review-by-provider}],
   :from :state/completed,
   :to :state/reviewed-by-provider}
  {:name :transition/review-2-by-provider,
   :actor :actor.role/provider,
   :actions
   [{:name :action/post-review-by-provider}
    {:name :action/publish-reviews}],
   :from :state/reviewed-by-customer,
   :to :state/reviewed}
  {:name :transition/review-1-by-customer,
   :actor :actor.role/customer,
   :actions [{:name :action/post-review-by-customer}],
   :from :state/completed,
   :to :state/reviewed-by-customer}
  {:name :transition/review-2-by-customer,
   :actor :actor.role/customer,
   :actions
   [{:name :action/post-review-by-customer}
    {:name :action/publish-reviews}],
   :from :state/reviewed-by-provider,
   :to :state/reviewed}
  {:name :transition/expire-review-period,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/completed]}
     {:fn/period ["P7D"]}]},
   :actions [],
   :from :state/completed,
   :to :state/reviewed}
  {:name :transition/expire-provider-review-period,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/completed]}
     {:fn/period ["P7D"]}]},
   :actions [{:name :action/publish-reviews}],
   :from :state/reviewed-by-customer,
   :to :state/reviewed}
  {:name :transition/expire-customer-review-period,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/first-entered-state :state/completed]}
     {:fn/period ["P7D"]}]},
   :actions [{:name :action/publish-reviews}],
   :from :state/reviewed-by-provider,
   :to :state/reviewed}],
 :notifications
 [{:name :notification/pickup-new-order,
   :on :transition/confirm-payment,
   :to :actor.role/provider,
   :template :pickup-new-order}
  {:name :notification/pickup-accepted,
   :on :transition/accept,
   :to :actor.role/customer,
   :template :pickup-accepted}
  {:name :notification/pickup-declined,
   :on :transition/decline,
   :to :actor.role/customer,
   :template :pickup-declined}
  {:name :notification/pickup-expired,
   :on :transition/expire,
   :to :actor.role/customer,
   :template :pickup-declined}
  {:name :notification/pickup-ready,
   :on :transition/mark-ready,
   :to :actor.role/customer,
   :template :pickup-ready}
  {:name :notification/pickup-cancelled-from-accepted,
   :on :transition/provider-cancel-from-accepted,
   :to :actor.role/customer,
   :template :pickup-cancelled}
  {:name :notification/pickup-cancelled-from-ready,
   :on :transition/provider-cancel-from-ready,
   :to :actor.role/customer,
   :template :pickup-cancelled}
  {:name :notification/pickup-completed,
   :on :transition/complete-pickup,
   :to :actor.role/provider,
   :template :pickup-completed}
  {:name :notification/pickup-auto-completed,
   :on :transition/auto-complete,
   :to :actor.role/provider,
   :template :pickup-completed}
  {:name :notification/review-period-start-provider,
   :on :transition/complete-pickup,
   :to :actor.role/provider,
   :template :pickup-review-by-provider-wanted}
  {:name :notification/review-period-start-customer,
   :on :transition/complete-pickup,
   :to :actor.role/customer,
   :template :pickup-review-by-customer-wanted}
  {:name :notification/review-period-start-provider-auto,
   :on :transition/auto-complete,
   :to :actor.role/provider,
   :template :pickup-review-by-provider-wanted}
  {:name :notification/review-period-start-customer-auto,
   :on :transition/auto-complete,
   :to :actor.role/customer,
   :template :pickup-review-by-customer-wanted}
  {:name :notification/review-by-provider-first,
   :on :transition/review-1-by-provider,
   :to :actor.role/customer,
   :template :pickup-review-by-other-party-unpublished}
  {:name :notification/review-by-customer-first,
   :on :transition/review-1-by-customer,
   :to :actor.role/provider,
   :template :pickup-review-by-other-party-unpublished}
  {:name :notification/review-by-provider-second,
   :on :transition/review-2-by-provider,
   :to :actor.role/customer,
   :template :pickup-review-by-other-party-published}
  {:name :notification/review-by-customer-second,
   :on :transition/review-2-by-customer,
   :to :actor.role/provider,
   :template :pickup-review-by-other-party-published}]}
