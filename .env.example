# Campus Connect / Sharetribe Web Template environment
# Copy to .env and fill values. Never commit .env.

# --- Sharetribe Marketplace API (browser + trusted server) ---
REACT_APP_SHARETRIBE_SDK_CLIENT_ID=
SHARETRIBE_SDK_CLIENT_SECRET=

# --- Sharetribe Integration API (server/worker only) ---
SHARETRIBE_INTEGRATION_CLIENT_ID=
SHARETRIBE_INTEGRATION_CLIENT_SECRET=

# --- Stripe (publishable only in the browser) ---
REACT_APP_STRIPE_PUBLISHABLE_KEY=
# Stripe secret key goes in Sharetribe Console, not here.

# --- App ---
REACT_APP_MARKETPLACE_ROOT_URL=http://localhost:3000
REACT_APP_MARKETPLACE_NAME=Campus Connect
REACT_APP_ENV=production
REACT_APP_CSP=report
# REACT_APP_SHARETRIBE_USING_SSL=true
# SERVER_SHARETRIBE_TRUST_PROXY=true

# --- Campus Connect ---
REDIS_URL=redis://127.0.0.1:6379
QR_SIGNING_SECRET=          # 32+ random bytes, base64
ALLOWED_EMAIL_DOMAINS=sdsu.edu
SUPPORT_INBOX=
EMAIL_PROVIDER_API_KEY=
SENTRY_DSN=
# REACT_APP_SENTRY_DSN=

# Optional template vars
REACT_APP_MAPBOX_ACCESS_TOKEN=
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
